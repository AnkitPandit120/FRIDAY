                },
                {
                    "role": "user",
                    "text": "\u0939\u0947\u0932\u094b"
                },
                {
                    "role": "friday",
                    "text": "\u0928\u092e\u0938\u094d\u0924\u0947 Ankit! \u092e\u0948\u0902 Friday \u0939\u0942\u0901, \u0915\u0948\u0938\u0947 \u092e\u0926\u0926 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0901?"
                },
                {
                    "role": "user",
                    "text": "\u0913 \u092a\u0928 \u092b\u093e\u0907\u0902\u0921\u0930"
                },
                {
                    "role": "friday",
                    "text": "Finder \u0916\u094b\u0932 \u0926\u093f\u092f\u093e"
                },
                {
                    "role": "user",
                    "text": "\u092a\u093f \u0928 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u092b\u094b\u0932\u094d\u0921\u0930"
                },
                {
                    "role": "friday",
                    "text": "\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0916\u094b\u0932 \u0926\u093f\u092f\u093e \u0939\u0948, \u0907\u0938\u092e\u0947\u0902 \u092f\u0947 32 \u0906\u0907\u091f\u092e \u0939\u0948\u0902\u0964"
                },
                {
                    "role": "user",
                    "text": "\u0921\u093f \u0932\u0940 \u091f \u0926\u0940 \u092b\u094b \u0932\u094d\u0921\u0930 \u0928\u0947 \u092e \u090f \u092b \u0913 \u090f \u0906\u0908 \u092b\u094d\u0930\u0949\u092e \u0921\u093e\u0909\u0928\u0932\u094b\u0921\u094d\u0938"
                },
                {
                    "role": "friday",
                    "text": "\u092e\u093e\u092b\u093c \u0915\u0940\u091c\u093f\u090f\u0917\u093e, \u092e\u0941\u091d\u0947 \"foai\" \u0928\u093e\u092e\u0915 \u0915\u094b\u0908 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964"
                },
                {
                    "role": "user",
                    "text": "foai"
                },
                {
                    "role": "friday",
                    "text": "\u0913\u0939, \u0915\u094d\u0937\u092e\u093e \u0915\u0930\u0947\u0902\u0964 \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \"foai\" \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0926\u093f\u0916 \u0930\u0939\u093e \u0939\u0948\u0964 \u092e\u0948\u0902 \u0907\u0938\u0947 \u092b\u093f\u0930 \u0938\u0947 \u0939\u091f\u093e\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0924\u093e \u0939\u0942\u0901\u0964"
                },
                {
                    "role": "user",
                    "text": "Is it done"
                },
                {
                    "role": "friday",
                    "text": "\u0928\u0939\u0940\u0902, \u092f\u0939 \u0905\u092d\u0940 \u092d\u0940 \u0928\u0939\u0940\u0902 \u0939\u094b \u092a\u093e \u0930\u0939\u093e \u0939\u0948\u0964 \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u094b \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0930\u0939\u093e \u0939\u0948, \u091c\u092c\u0915\u093f \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0926\u093f\u0916 \u0930\u0939\u093e \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0906\u092a \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0915\u093e \u0928\u093e\u092e \u0926\u094b\u092c\u093e\u0930\u093e \u091c\u093e\u0901\u091a \u0938\u0915\u0924\u0947 \u0939\u0948\u0902?"
                },
                {
                    "role": "user",
                    "text": "\u0907\u0928 \u0921\u093e\u0909 \u0928\u0932\u094b \u0921\u094d\u0938 \u092b\u094b \u0932\u094d\u0921\u0930 \u0926\u0947 \u092f\u0930 \u0907\u091c \u0905 \u0926\u0930 \u092b\u094b \u0932\u094d\u0921\u0930 \u0928\u0947 \u092e \u090f\u092b \u0913 \u090f \u0906\u0908"
                },
                {
                    "role": "friday",
                    "text": "\u0920\u0940\u0915 \u0939\u0948, \u092e\u0948\u0902 \u090f\u0915 \u092c\u093e\u0930 \u092b\u093f\u0930 \u0938\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930 \u0930\u0939\u093e \u0939\u0942\u0901\u0964 \u0915\u094d\u0937\u092e\u093e \u0915\u0930\u0947\u0902, \u092e\u0941\u091d\u0947 \u0905\u092d\u0940 \u092d\u0940 \u0935\u0939 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0930\u0939\u093e \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0915\u093e \u0928\u093e\u092e \u092f\u093e \u092a\u0925 \u0938\u0939\u0940 \u0939\u0948?"
                },
                {
                    "role": "user",
                    "text": "exit"
                }
            ]
        }
